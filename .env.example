# Port for the Go backend API
PORT=8080

# Local SQLite database path (relative to backend/)
DB_PATH=data/vizag_transit.db

# Cached APSRTC GTFS static zip path (auto-downloaded if missing)
GTFS_ZIP_PATH=data/apsrtc.zip

# GTFS-Realtime feed poll interval in seconds (minimum 5)
RT_POLL_SECONDS=12

# Seconds after which a vehicle GPS timestamp is marked stale
STALE_THRESHOLD_SECONDS=300

# Seconds after which an inactive vehicle is expired from the live map
MAX_VEHICLE_AGE_SECONDS=3600
